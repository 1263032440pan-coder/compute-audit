FROM --platform=$BUILDPLATFORM golang:1.26.1-bookworm AS build

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/audit-agent ./cmd/audit-agent

FROM scratch
COPY --from=build /out/audit-agent /audit-agent
USER 65532:65532
ENTRYPOINT ["/audit-agent"]
CMD ["--config", "/etc/compute-audit/agent.yaml"]
